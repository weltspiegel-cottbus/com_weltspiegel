<?xml version="1.0" encoding="UTF-8"?>
<form>
    <field
            name="id"
            type="hidden"
    />

    <field
            name="title"
            type="text"
            label="Titel"
            description="Titel der Vorschau"
            required="true"
            class="form-control"
            size="40"
    />

    <field
            name="introtext"
            type="editor"
            label="Kurzbeschreibung"
            description="Kurze Beschreibung für die Vorschau"
            filter="safehtml"
            buttons="true"
    />

    <field
            name="fulltext"
            type="editor"
            label="Vollständiger Text"
            description="Ausführliche Beschreibung der Vorschau"
            filter="safehtml"
            buttons="true"
    />

    <field
            name="images"
            type="media"
            label="Banner/Poster"
            description="Wählen Sie ein Bild für die Vorschau"
            directory="images/vorschauen"
    />

    <field
            name="state"
            type="list"
            label="Status"
            description="Veröffentlichungsstatus"
            default="1"
            class="form-select"
    >
        <option value="1">Veröffentlicht</option>
        <option value="0">Nicht veröffentlicht</option>
        <option value="2">Archiviert</option>
        <option value="-2">Papierkorb</option>
    </field>

    <field
            name="catid"
            type="hidden"
            default="8"
    />

    <fields name="attribs" label="Erweiterte Optionen">
        <fieldset name="advanced" label="Erweiterte Optionen">
            <field
                    name="youtube_url"
                    type="text"
                    label="YouTube Trailer"
                    description="Gib eine YouTube URL (https://www.youtube.com/watch?v=...) oder nur die Video ID ein"
                    hint="z.B. dQw4w9WgXcQ oder vollständige URL"
                    class="form-control"
                    size="40"
            />
        </fieldset>
    </fields>
</form>
