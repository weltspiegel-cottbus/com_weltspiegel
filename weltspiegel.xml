<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">

    <name>Weltspiegel</name>
    <version>2.2.0</version>
    <creationDate>27.06.2026</creationDate>
    <author>Michael Buchholz</author>
    <authorEmail>mail@lean-stack.rocks</authorEmail>
    <copyright>Weltspiegel Cottbus</copyright>
    <license>MIT; see LICENSE</license>
    <description>Joomla-Komponente für den Weltspiegel Cottbus</description>

    <namespace path="src">Weltspiegel\Component\Weltspiegel</namespace>

    <scriptfile>script.php</scriptfile>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/weltspiegel.install.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/weltspiegel.uninstall.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates</schemapath>
        </schemas>
    </update>

    <administration>
        <menu>COM_WELTSPIEGEL</menu>
        <submenu>
            <menu link="option=com_weltspiegel&amp;view=movies">COM_WELTSPIEGEL_MENU_MOVIES</menu>
            <menu link="option=com_weltspiegel&amp;view=vorschauen">COM_WELTSPIEGEL_MENU_VORSCHAUEN</menu>
            <menu link="option=com_weltspiegel&amp;view=veranstaltungen">COM_WELTSPIEGEL_MENU_VERANSTALTUNGEN</menu>
        </submenu>
        <files folder="administrator/components/com_weltspiegel">
            <folder>forms</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <filename>access.xml</filename>
            <filename>config.xml</filename>
        </files>
        <languages folder="administrator/components/com_weltspiegel/language">
            <language tag="de-DE">de-DE/com_weltspiegel.ini</language>
            <language tag="de-DE">de-DE/com_weltspiegel.sys.ini</language>
            <language tag="en-GB">en-GB/com_weltspiegel.ini</language>
            <language tag="en-GB">en-GB/com_weltspiegel.sys.ini</language>
        </languages>
    </administration>

    <files folder="components/com_weltspiegel">
        <folder>services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <updateservers>
        <server type="extension" priority="1" name="Weltspiegel Component Updates">https://raw.githubusercontent.com/weltspiegel-cottbus/com_weltspiegel/main/update-manifest.xml</server>
    </updateservers>
</extension>
